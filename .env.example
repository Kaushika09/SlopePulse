# Backend environment variables (copy to backend/.env for local use).
# Never commit a filled-in .env - only this example file.

# Comma-separated list of origins allowed to call the API.
# Local development + your deployed Vercel URL.
ALLOWED_ORIGINS=http://localhost:3000,https://slopepulse.vercel.app

# Optional: set by Render automatically. Only needed locally.
PORT=8000
